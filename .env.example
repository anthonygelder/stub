# ── Required (production) ──────────────────────────
NODE_ENV=production

# Database — Railway auto-provides when you add PostgreSQL
DATABASE_URL=postgresql://...

# Redis — Railway auto-provides when you add Redis
REDIS_URL=redis://...

# JWT secrets — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Your Railway app URL (e.g. https://stub.up.railway.app)
CLIENT_URL=

# ── OAuth (Google) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth (Apple) — optional ───────────────────────
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
