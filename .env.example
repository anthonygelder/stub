# ── Required (production) ──────────────────────────
NODE_ENV=production

# Database — Railway auto-provides when you add PostgreSQL
DATABASE_URL=postgresql://...

# Redis — Railway auto-provides when you add Redis.
# Required for OAuth login (code exchange) and the home feed; the app boots and
# stays healthy without it, but those features degrade.
REDIS_URL=redis://...

# Optional: share rate limits across instances via Redis. Leave unset to use a
# per-instance in-memory limiter (recommended for a single instance).
# RATE_LIMIT_REDIS=true

# JWT secrets — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Your Railway app URL (e.g. https://stub.up.railway.app)
CLIENT_URL=

# ── Storage ────────────────────────────────────────
# 'local' (default; files written to server/data, served at /media) or 's3'.
# Local files are EPHEMERAL on Railway — use 's3' (or a Railway Volume) in prod.
STORAGE_DRIVER=local
# Required when STORAGE_DRIVER=s3 (works with AWS S3 and Cloudflare R2):
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=            # e.g. https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=     # public bucket/CDN base, e.g. https://media.stub.app

# ── Inbound email ──────────────────────────────────
# Shared secret for the POST /api/inbound webhook. Point your email provider's
# inbound parse (e.g. SendGrid Inbound Parse, MX of stub.app -> provider) at
# https://<app>/api/inbound?token=<this-secret> (or send an x-webhook-secret
# header). Forwarded tickets to <handle>.<id>@stub.app become draft stubs.
INBOUND_WEBHOOK_SECRET=

# ── OAuth (Google) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth (Apple) — optional ───────────────────────
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
